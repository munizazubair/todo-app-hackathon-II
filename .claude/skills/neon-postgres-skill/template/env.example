# Neon Postgres Environment Variables
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# PRIMARY CONNECTION STRING (Recommended)
# =============================================================================

# Main database URL (get this from Neon console)
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# ALTERNATIVE: POOLED AND DIRECT CONNECTIONS
# =============================================================================

# Pooled connection (recommended for serverless/Next.js API routes)
# Uses Neon's built-in connection pooler (PgBouncer)
# Endpoint format: ep-xxx-pooler.region.aws.neon.tech
DATABASE_URL_POOLED=postgresql://username:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection (recommended for migrations and admin tasks)
# Direct connection to PostgreSQL without pooling
# Endpoint format: ep-xxx.region.aws.neon.tech
DATABASE_URL_DIRECT=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# ALTERNATIVE: INDIVIDUAL COMPONENTS
# =============================================================================

# If you prefer to construct the connection string manually
NEON_DB_HOST=ep-xxx-xxx.region.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_NAME=neondb
NEON_DB_USER=username
NEON_DB_PASSWORD=password
NEON_SSL_MODE=require

# =============================================================================
# NEON PROJECT INFORMATION (Optional)
# =============================================================================

# Neon project ID (for API access)
NEON_PROJECT_ID=your-project-id

# Neon API key (if using Neon API for management)
NEON_API_KEY=your-api-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Application port
PORT=3000

# API base URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend API port (FastAPI)
API_PORT=8000

# =============================================================================
# SECURITY (Optional)
# =============================================================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# JWT expiration time (in seconds)
JWT_EXPIRATION=3600

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable SQL query logging (true/false)
SQL_LOGGING=false

# =============================================================================
# NOTES
# =============================================================================

# How to get your Neon connection string:
# 1. Go to https://console.neon.tech
# 2. Select your project
# 3. Click "Connection Details"
# 4. Copy the connection string
# 5. Choose between pooled and direct connection endpoints

# Connection string format:
# postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require

# Pooled vs Direct:
# - Pooled: Use for application connections (Next.js, FastAPI)
# - Direct: Use for migrations, database admin, schema changes

# Security best practices:
# 1. Never commit .env file to version control
# 2. Add .env to .gitignore
# 3. Use different credentials for development and production
# 4. Rotate credentials regularly
# 5. Use environment-specific .env files (.env.development, .env.production)

# =============================================================================
# EXAMPLE USAGE IN CODE
# =============================================================================

# Node.js / Next.js:
# import { Pool } from 'pg'
# const pool = new Pool({ connectionString: process.env.DATABASE_URL })

# Python / FastAPI:
# import os
# from sqlalchemy import create_engine
# engine = create_engine(os.getenv("DATABASE_URL"))
